# LLM, any OpenAI-compatible provider. In production set these in Vercel (Project Settings > Environment Variables).
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Local development only: FreeLLMAPI router (fallback when LLM_* is empty)
FREELLM_API_KEY=
FREELLM_BASE_URL=http://localhost:3001/v1
FREELLM_MODEL=auto

# Optional: INEGI DENUE API token (the bulk CSV needs no token)
DENUE_TOKEN=

# Optional: only for tools/mapas.py (Google Places)
GOOGLE_MAPS_API_KEY=
